rules_version = '2';
// Security rules for the Tech Club mountain (Cloud Firestore).
// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Members never write points: they add facts, and points are recomputed from rules/rules.yaml.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    // Only @aivancity.education accounts: verified by the email link, or signed in with Microsoft.
    // The Microsoft app is registered single-tenant (aivancity's directory only), so Microsoft vouches for the address.
    // An organizer can also confirm someone by hand (confirmed/{uid}) when the confirmation email never arrives.
    function schoolEmail() { return signedIn() && request.auth.token.email.matches('.*@aivancity[.]education$'); }
    // A school account counts once its email is confirmed, OR (while the school's email blocks our confirmation emails)
    // once an organizer has approved it on /pulse (confirmed/{uid}). An organizer can also refuse an account (blocked/{uid}).
    // Joining without waiting: true = any @aivancity.education account counts straight away (organizers can still refuse an
    // account on /pulse, which blocks it). false = wait for the confirmation email or an organizer's approval.
    // Keep it in step with CONFIRM in assets/platform/config.js ("none" = true; "organizer" or "email" = false).
    function instantJoin() { return true; }
    function school() {
      return schoolEmail() && !exists(/databases/$(db)/documents/blocked/$(request.auth.uid))
        && (instantJoin() || request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'microsoft.com'
            || exists(/databases/$(db)/documents/confirmed/$(request.auth.uid)));
    }
    function email() { return request.auth.token.email.lower(); }
    function notBlocked() { return !exists(/databases/$(db)/documents/blocked/$(request.auth.uid)); }
    // Who is in the club: a verified school account that either
    //  - sent the /apply form (requests/{uid}), unless an organizer set its status to 'removed', or
    //  - is on the roster (roster/{email}), added by an organizer.
    function req() { return /databases/$(db)/documents/requests/$(request.auth.uid); }
    function applied() { return exists(req()) && get(req()).data.get('status', '') != 'removed'; }
    function onRoster() { return school() && (exists(/databases/$(db)/documents/roster/$(email())) || applied()); }
    function memberDoc() { return get(/databases/$(db)/documents/members/$(request.auth.uid)); }
    function isMember() { return onRoster() && exists(/databases/$(db)/documents/members/$(request.auth.uid)); }
    function isOrganizer() { return isMember() && memberDoc().data.get('role', 'member') == 'organizer'; }
    function code(c) { return get(/databases/$(db)/documents/checkinCodes/$(c)).data; }
    function boardDoc(id) { return /databases/$(db)/documents/board/$(id); }
    function myMember() { return /databases/$(db)/documents/members/$(request.auth.uid); }
    // your "current mission" can only point at a mission that this same write gives to you
    function activeMissionOk(m) { return m == null || getAfter(boardDoc(m)).data.get('takenBy', null) == request.auth.uid; }
    function onlyKeys(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // reporting: add yourself (and only yourself) to the reports map
    function reportOnly() {
      return onlyKeys(['reports'])
        && request.resource.data.reports.diff(resource.data.reports).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.reports[request.auth.uid] == true;
    }

    // Public profile inside the club: name, GitHub username, accessories. Roles are set by an owner in the console.
    match /members/{uid} {
      allow read: if isMember();
      // anyone signed in can check their own profile, even before it exists (first visit)
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if onRoster() && request.auth.uid == uid
        && request.resource.data.consent == true
        && !('role' in request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update: if isMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'github', 'accessories', 'activeMission'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.get('github', '') is string && request.resource.data.get('github', '').size() <= 39
        && request.resource.data.accessories.size() <= 2
        && (request.resource.data.get('activeMission', null) == resource.data.get('activeMission', null)
            || activeMissionOk(request.resource.data.get('activeMission', null)));
      // "Delete this person's data" on /pulse (never an organizer's profile)
      allow delete: if isOrganizer() && request.auth.uid != uid && resource.data.get('role', 'member') != 'organizer';
    }

    // Roster: document ID = the member's full school email address, in lower case.
    // Members can only check their own entry; organizers manage the list.
    match /roster/{em} {
      allow get: if school() && em == email();
      allow list, write: if isOrganizer();
    }

    // Joining the club (the one Join form: name, WhatsApp number, level, optional GitHub). Sent together with the account,
    // before an organizer approves it; it only counts once the account is approved (see school() / onRoster()).
    // Only the person and organizers can read it.
    function validRequest(d) {
      return d.keys().hasOnly(['email', 'name', 'program', 'phone', 'interests', 'level', 'heard', 'consent', 'lang', 'at', 'status', 'note', 'github'])
        && (!('github' in d) || (d.github is string && d.github.size() <= 39))
        && d.email == email()
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.program is string && d.program.size() <= 60
        && d.phone is string && d.phone.matches('^[+]?[0-9 ().-]{6,20}$')
        && d.interests is list && d.interests.size() <= 8
        && d.level in ['new', 'some', 'solid']
        && d.heard is string && d.heard.size() <= 200
        && d.consent == true
        && d.lang in ['en', 'fr']
        && d.at == request.time;
    }
    match /requests/{uid} {
      // a new account can send it before an organizer has reviewed it (when registering for an event);
      // it only counts as membership once the account is confirmed (see school() / onRoster())
      allow create: if schoolEmail() && notBlocked() && request.auth.uid == uid && validRequest(request.resource.data)
        && !('status' in request.resource.data) && !('note' in request.resource.data);
      // The person can edit their answers; only organizers set status ('invited', 'added') and notes.
      allow update: if schoolEmail() && notBlocked() && request.auth.uid == uid && validRequest(request.resource.data)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('note', null) == resource.data.get('note', null);
      allow update: if isOrganizer();
      allow get: if signedIn() && request.auth.uid == uid;
      allow get, list, delete: if isOrganizer();
    }

    // The WhatsApp invite link (invites/whatsapp { link }) is kept here, never in the public repository.
    // Only people who sent the form (or are on the roster) can read it. Organizers set it in the console.
    match /invites/{id} {
      allow get: if school() && (exists(/databases/$(db)/documents/requests/$(request.auth.uid)) || onRoster());
      allow list, write: if isOrganizer();
    }

    // Feedback (the /feedback form). Anyone can send it, signed in or not; only organizers can read it.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['topic', 'rating', 'message', 'contact', 'lang', 'createdAt'])
        && request.resource.data.topic in ['sessions', 'platform', 'club', 'stopped', 'idea', 'problem', 'other']
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && (!('rating' in request.resource.data) || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 120))
        && request.resource.data.lang in ['en', 'fr']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isOrganizer();
      allow update: if false;
    }

    // The confirmation email didn't arrive: the person asks an organizer to confirm them by hand.
    match /confirmPending/{uid} {
      allow create, update: if schoolEmail() && notBlocked() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'at'])
        && request.resource.data.email == email()
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.at == request.time;
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow read, delete: if isOrganizer();
    }
    match /confirmed/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read, write: if isOrganizer();
    }
    match /blocked/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow read, write: if isOrganizer();
    }

    // Email addresses: only the person and organizers can read them.
    match /private/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isOrganizer();
      // only your own address, exactly as your account has it
      allow create, update: if onRoster() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email']) && request.resource.data.email.lower() == email();
      allow delete: if (onRoster() && request.auth.uid == uid) || isOrganizer();
    }

    // ---------- Village Board: missions, events, open-source projects ----------
    // Everything is visible to members. Elders (organizers) can hide anything; members can report.
    // a post with a closing day can't be taken after that day (UTC); the page hides it on its own
    function notExpired(d) {
      return !('expires' in d) || request.time < timestamp.date(int(d.expires.split('-')[0]), int(d.expires.split('-')[1]), int(d.expires.split('-')[2])) + duration.value(1, 'd');
    }
    match /board/{id} {
      allow get, list: if isMember() && (resource.data.hidden == false || isOrganizer());

      allow create: if isMember()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(['kind', 'title', 'body', 'link', 'by', 'createdAt', 'hidden', 'reports', 'mtype', 'status', 'takenBy', 'takenAt', 'date', 'where', 'start', 'days', 'outcome', 'time', 'level', 'skills', 'as', 'expires', 'for'])
        && request.resource.data.kind in ['mission', 'event', 'oss', 'week']
        && request.resource.data.get('outcome', '') is string && request.resource.data.get('outcome', '').size() <= 300
        && request.resource.data.get('time', 'lt1') in ['lt1', '1to3', 'sessions', 'ongoing']
        && request.resource.data.get('level', 'all') in ['all', 'beginner', 'intermediate', 'advanced']
        && request.resource.data.get('skills', []) is list && request.resource.data.get('skills', []).size() <= 5
        // only elders (organizers) can post in the name of the organizing team or the council
        && (!('as' in request.resource.data) || (isOrganizer() && request.resource.data['as'] in ['team', 'council']))
        // a buddy mission names the newcomer it is for (organizers only)
        && (!('for' in request.resource.data) || (isOrganizer() && request.resource.data['for'] is string))
        // optional closing day (YYYY-MM-DD); weekly themes end on their own
        && (!('expires' in request.resource.data) || (request.resource.data.kind != 'week' && request.resource.data.expires is string
            && request.resource.data.expires.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (request.resource.data.kind != 'week'
            || (isOrganizer() && request.resource.data.start is string && request.resource.data.days is list && request.resource.data.days.size() <= 7))
        && request.resource.data.title is string && request.resource.data.title.size() > 2 && request.resource.data.title.size() <= 90
        && request.resource.data.body is string && request.resource.data.body.size() <= 800
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && request.resource.data.hidden == false && request.resource.data.reports == {}
        && request.resource.data.createdAt == request.time
        && (request.resource.data.kind != 'mission'
            || (request.resource.data.mtype in ['help', 'build', 'club'] && request.resource.data.status == 'open' && request.resource.data.takenBy == null));

      // the author edits the text (a mission only while it's still open), or closes their own open mission
      allow update: if isMember() && resource.data.by == request.auth.uid && resource.data.hidden == false
        && (resource.data.kind != 'mission' || resource.data.status == 'open')
        && onlyKeys(['title', 'body', 'link', 'date', 'where', 'status', 'start', 'days', 'outcome', 'time', 'level', 'skills', 'expires', 'editedAt'])
        && (request.resource.data.get('editedAt', null) == resource.data.get('editedAt', null) || request.resource.data.editedAt == request.time)
        && request.resource.data.get('outcome', '') is string && request.resource.data.get('outcome', '').size() <= 300
        && request.resource.data.get('time', 'lt1') in ['lt1', '1to3', 'sessions', 'ongoing']
        && request.resource.data.get('level', 'all') in ['all', 'beginner', 'intermediate', 'advanced']
        && request.resource.data.get('skills', []) is list && request.resource.data.get('skills', []).size() <= 5
        && (!('expires' in request.resource.data) || (request.resource.data.kind != 'week' && request.resource.data.expires is string
            && request.resource.data.expires.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && request.resource.data.link is string && request.resource.data.link.size() <= 300
        && request.resource.data.title.size() > 2 && request.resource.data.title.size() <= 90 && request.resource.data.body.size() <= 800
        && (request.resource.data.get('status', null) == resource.data.get('status', null)
            || (resource.data.status == 'open' && request.resource.data.status == 'closed'));

      // take an open mission: first come first served, never your own, and only if you have no other mission
      allow update: if isMember() && resource.data.kind == 'mission' && resource.data.hidden == false
        && resource.data.status == 'open' && resource.data.by != request.auth.uid
        && onlyKeys(['status', 'takenBy', 'takenAt'])
        && request.resource.data.status == 'taken' && request.resource.data.takenBy == request.auth.uid && request.resource.data.takenAt == request.time
        && notExpired(resource.data)
        && get(myMember()).data.get('activeMission', null) == null
        && getAfter(myMember()).data.get('activeMission', null) == id;

      // the taker gives it back, or marks it done (it then waits for the poster)
      allow update: if isMember() && resource.data.kind == 'mission' && resource.data.takenBy == request.auth.uid
        && resource.data.status == 'taken'
        && ((onlyKeys(['status', 'takenBy', 'takenAt']) && request.resource.data.status == 'open' && request.resource.data.takenBy == null)
            || (onlyKeys(['status', 'doneAt']) && request.resource.data.status == 'review' && request.resource.data.doneAt == request.time));

      // a mission taken more than 7 days ago with no news goes back on the board (anyone can trigger it)
      allow update: if isMember() && resource.data.kind == 'mission' && resource.data.status == 'taken'
        && request.time > resource.data.takenAt + duration.value(7, 'd')
        && onlyKeys(['status', 'takenBy', 'takenAt']) && request.resource.data.status == 'open' && request.resource.data.takenBy == null;

      // the poster confirms (the matching points fact is created in the same write, see /facts rule 4)
      allow update: if isMember() && resource.data.kind == 'mission' && resource.data.by == request.auth.uid
        && resource.data.status == 'review' && onlyKeys(['status', 'confirmedAt'])
        && request.resource.data.status == 'done' && request.resource.data.confirmedAt == request.time
        && existsAfter(/databases/$(db)/documents/facts/$('m_' + id));

      allow update: if isMember() && reportOnly();
      allow update, delete: if isOrganizer();
      allow delete: if isMember() && resource.data.by == request.auth.uid && resource.data.get('status', 'open') in ['open', 'closed'];

      match /comments/{cid} {
        allow get, list: if isMember() && (resource.data.hidden == false || isOrganizer());
        allow create: if isMember() && request.resource.data.by == request.auth.uid
          && request.resource.data.keys().hasOnly(['by', 'text', 'createdAt', 'hidden', 'reports'])
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
          && request.resource.data.hidden == false && request.resource.data.reports == {}
          && request.resource.data.createdAt == request.time;
        allow update: if isMember() && reportOnly();
        allow update: if isOrganizer();
        allow delete: if isMember() && (resource.data.by == request.auth.uid || isOrganizer());
      }
    }

    // ---------- Sessions: votes on planned sessions (members only) ----------
    // One document per person and session: id = "YYYY-MM-DD_uid".
    // rsvps: the old "I'm going" (now in registrations). Nothing new is written; the site moves each member's own over and removes them.
    match /rsvps/{id} {
      allow read: if isMember();
      allow delete: if (isMember() && resource.data.uid == request.auth.uid) || isOrganizer();
    }
    match /votes/{id} {
      allow read: if isMember();
      allow create, update: if isMember() && id == request.resource.data.date + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['date', 'uid', 'choice', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z0-9-]{1,40})?$')
        && request.resource.data.choice is string && request.resource.data.choice.size() > 0 && request.resource.data.choice.size() <= 40
        && request.resource.data.at == request.time;
      allow delete: if (isMember() && resource.data.uid == request.auth.uid) || isOrganizer();
    }

    // ---------- Camps: each member's own space on the Mountain (members only) ----------
    function proudOk(p) { return p is map && p.keys().hasOnly(['title', 'text', 'link']) && p.title is string && p.title.size() <= 80
      && p.text is string && p.text.size() <= 200 && p.link is string && p.link.size() <= 300; }
    function campOk(d) {
      return d.color in ['sky', 'mint', 'sun', 'rose', 'lilac', 'sand', 'night', 'forest']
        && d.working is string && d.working.size() <= 140 && d.dream is string && d.dream.size() <= 60
        && d.askMe is string && d.askMe.size() <= 140 && d.about is string && d.about.size() <= 280
        && d.song is string && d.song.size() <= 300
        && d.proud is list && d.proud.size() <= 4
        && (d.proud.size() < 1 || proudOk(d.proud[0])) && (d.proud.size() < 2 || proudOk(d.proud[1]))
        && (d.proud.size() < 3 || proudOk(d.proud[2])) && (d.proud.size() < 4 || proudOk(d.proud[3]))
        && d.updatedAt == request.time;
    }
    match /camps/{uid} {
      allow get: if isMember() && (resource.data.hidden == false || request.auth.uid == uid || isOrganizer());
      allow create: if isMember() && request.auth.uid == uid && campOk(request.resource.data)
        && request.resource.data.keys().hasOnly(['color', 'working', 'dream', 'askMe', 'about', 'song', 'proud', 'updatedAt', 'hidden', 'reports'])
        && request.resource.data.hidden == false && request.resource.data.reports == {};
      allow update: if isMember() && request.auth.uid == uid && campOk(request.resource.data)
        && onlyKeys(['color', 'working', 'dream', 'askMe', 'about', 'song', 'proud', 'updatedAt']);
      allow update: if isMember() && request.auth.uid != uid && reportOnly();
      allow update: if isOrganizer() && onlyKeys(['hidden']);
      allow delete: if isOrganizer();
    }

    // Organizers only: who has been contacted after drifting away (pulse/{uid} { contactedAt, by }).
    match /pulse/{uid} {
      allow read, write: if isOrganizer();
    }

    // ---------- Events made on the site by organizers (events/{id}) ----------
    // Anyone can see published events (the schedule is public); only organizers create, edit or delete them.
    function eventOk(d) {
      return d.keys().hasOnly(['title', 'title_fr', 'date', 'time', 'time_fr', 'room', 'type', 'type_fr', 'format', 'level', 'lang', 'track',
          'description', 'description_fr', 'details', 'details_fr', 'speaker', 'link', 'linkText', 'registration', 'capacity', 'deadline', 'published',
          'cancelled', 'hidden', 'deleted', 'autoConfirm',
          'createdBy', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.description is string && d.description.size() <= 300
        && d.details is string && d.details.size() <= 5000 && d.details_fr is string && d.details_fr.size() <= 5000
        && d.registration is bool && d.published is bool
        && (d.get('deadline', '') == '' || (d.deadline is string && d.deadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && d.get('cancelled', false) is bool && d.get('hidden', false) is bool && d.get('deleted', false) is bool && d.get('autoConfirm', true) is bool
        && d.capacity is int && d.capacity >= 0 && d.capacity <= 1000;
    }
    match /events/{id} {
      allow read: if resource.data.published == true || isOrganizer();
      allow create, update: if isOrganizer() && eventOk(request.resource.data);
      allow delete: if isOrganizer();
    }

    // Registrations (registrations/{eventId}_{uid}): the one "I'm going" for every session. Any school account can ask for a spot,
    // even before an organizer has reviewed the account. Members can be confirmed straight away; everyone else waits ('pending')
    // until an organizer confirms. Private: each person sees only their own; organizers see everyone (and the counts).
    function regOk(id) {
      return schoolEmail() && notBlocked()
        && request.resource.data.keys().hasOnly(['event', 'uid', 'status', 'at'])
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.event + '_' + request.auth.uid
        && request.resource.data.at == request.time
        && (request.resource.data.status in ['pending', 'waitlist', 'cancelled'] || (request.resource.data.status == 'confirmed' && isMember()));
    }
    // Is this event taking sign-ups? A session from the schedule file ("d-YYYY-MM-DD", maybe with its own key) unless an organizer
    // cancelled, hid or deleted it; or a published event made on the site that isn't cancelled.
    // Sign-ups close at the end of the event's day (or of its registration deadline), UTC.
    function evPath(e) { return /databases/$(db)/documents/events/$(e); }
    function notOver(y, m, d) { return request.time < timestamp.date(int(y), int(m), int(d)) + duration.value(1, 'd'); }
    function dayNotOver(day) { return notOver(day.split('-')[0], day.split('-')[1], day.split('-')[2]); }
    function docOpen(x) {
      return x.get('cancelled', false) == false && x.get('hidden', false) == false && x.get('deleted', false) == false
        && dayNotOver(x.date) && (x.get('deadline', '') == '' || dayNotOver(x.deadline));
    }
    function eventOpen(e) {
      return e.matches('^d-[0-9]{4}-[0-9]{2}-[0-9]{2}(-[a-z0-9-]{1,40})?$')
        ? (exists(evPath(e)) ? docOpen(get(evPath(e)).data) : notOver(e.split('-')[1], e.split('-')[2], e.split('-')[3]))
        : (get(evPath(e)).data.published == true && docOpen(get(evPath(e)).data));
    }
    match /registrations/{id} {
      // your own spot (it may not exist yet), or your own list; organizers read everything
      allow get: if isOrganizer() || (signedIn() && id.matches('^.+_' + request.auth.uid + '$'));
      allow list: if isOrganizer() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if regOk(id) && request.resource.data.status != 'cancelled' && eventOpen(request.resource.data.event);
      // people can always cancel their own spot; anything else only while the event takes sign-ups
      allow update: if regOk(id) && resource.data.uid == request.auth.uid && resource.data.event == request.resource.data.event
        && (request.resource.data.status == 'cancelled' || eventOpen(request.resource.data.event));
      allow update: if isOrganizer() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['pending', 'confirmed', 'waitlist', 'cancelled'];
      allow delete: if isOrganizer();
    }

    // One document per session code: { date: "YYYY-MM-DD", validFrom: timestamp, validUntil: timestamp, double: bool }.
    // Members can't read or list codes; the check-in rule below only checks that a typed code exists.
    match /checkinCodes/{c} {
      allow read, write: if isOrganizer();
    }

    match /facts/{id} {
      allow read: if isMember();

      // 1) Check-in: the code must exist, be for today's session and be used inside its time window.
      allow create: if isMember()
        && request.resource.data.type == 'attend'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'approved'
        && id == request.auth.uid + '_' + request.resource.data.date
        && exists(/databases/$(db)/documents/checkinCodes/$(request.resource.data.code))
        && code(request.resource.data.code).date == request.resource.data.date
        && request.time >= code(request.resource.data.code).validFrom
        && request.time <= code(request.resource.data.code).validUntil;

      // 2) Proof submissions start as pending and earn nothing until an organizer verifies them.
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['ship_project', 'open_source', 'skill_badge', 'certification', 'mentoring']
        && request.resource.data.status == 'pending'
        && request.resource.data.proof is string && request.resource.data.proof.size() < 500;

      // 3) Organizers record results for other members (never for themselves).
      allow create: if isOrganizer()
        && request.resource.data.uid != request.auth.uid
        && request.resource.data.recordedBy == request.auth.uid;

      // 4) Village Board mission confirmed by the member who posted it (fact id = "m_" + mission id, so once only).
      //    The mission must move from "review" to "done" in the same write; the fact goes to the member who took it.
      allow create: if isMember()
        && id == 'm_' + request.resource.data.missionId
        && request.resource.data.keys().hasOnly(['uid', 'type', 'date', 'status', 'missionId', 'mentee', 'recordedBy', 'title', 'createdAt'])
        && get(boardDoc(request.resource.data.missionId)).data.status == 'review'
        && getAfter(boardDoc(request.resource.data.missionId)).data.status == 'done'
        && get(boardDoc(request.resource.data.missionId)).data.by == request.auth.uid
        && request.resource.data.uid == get(boardDoc(request.resource.data.missionId)).data.takenBy
        && request.resource.data.uid != request.auth.uid
        && ((get(boardDoc(request.resource.data.missionId)).data.mtype == 'help' && request.resource.data.type == 'mentoring')
            || (get(boardDoc(request.resource.data.missionId)).data.mtype == 'build' && request.resource.data.type == 'collab')
            || (get(boardDoc(request.resource.data.missionId)).data.mtype == 'club' && request.resource.data.type == 'club_quest'))
        && request.resource.data.status == 'approved'
        && request.resource.data.mentee == request.auth.uid
        && request.resource.data.recordedBy == request.auth.uid;

      // 5) Organizers verify submissions from other members. Only the decision fields can change.
      allow update: if isOrganizer()
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'verifiedBy', 'verifiedAt'])
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.status in ['approved', 'rejected'];

      // Facts are never deleted to correct something (corrections are new facts, so the log stays complete).
      // The one exception: an organizer erasing someone's data at their request ("Delete this person's data" on /pulse).
      allow delete: if isOrganizer() && resource.data.uid != request.auth.uid;
    }
  }
}
