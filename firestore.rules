rules_version = '2';
// Security rules for the Tech Club mountain (Cloud Firestore).
// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Members never write points: they add facts, and points are recomputed from rules/rules.yaml.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    // Only verified @aivancity.education accounts (email-link sign-in verifies the address).
    function school() {
      return signedIn() && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@aivancity[.]education$');
    }
    function email() { return request.auth.token.email.lower(); }
    // Who is in the club: a verified school account that either
    //  - sent the /apply form (requests/{uid}), unless an organizer set its status to 'removed', or
    //  - is on the roster (roster/{email}), added by an organizer.
    function req() { return /databases/$(db)/documents/requests/$(request.auth.uid); }
    function applied() { return exists(req()) && get(req()).data.get('status', '') != 'removed'; }
    function onRoster() { return school() && (exists(/databases/$(db)/documents/roster/$(email())) || applied()); }
    function memberDoc() { return get(/databases/$(db)/documents/members/$(request.auth.uid)); }
    function isMember() { return onRoster() && exists(/databases/$(db)/documents/members/$(request.auth.uid)); }
    function isOrganizer() { return isMember() && memberDoc().data.get('role', 'member') == 'organizer'; }
    function code(c) { return get(/databases/$(db)/documents/checkinCodes/$(c)).data; }

    // Public profile inside the club: name, GitHub username, accessories. Roles are set by an owner in the console.
    match /members/{uid} {
      allow read: if isMember();
      allow create: if onRoster() && request.auth.uid == uid
        && request.resource.data.consent == true
        && !('role' in request.resource.data)
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40;
      allow update: if isMember() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'github', 'accessories'])
        && request.resource.data.accessories.size() <= 2;
      allow delete: if false;
    }

    // Roster: document ID = member email in lower case, e.g. roster/amina.kone@aivancity.education
    // Members can only check their own entry; organizers manage the list.
    match /roster/{em} {
      allow get: if school() && em == email();
      allow list, write: if isOrganizer();
    }

    // Applications to join the club and its WhatsApp group (the /apply form).
    // Any verified school account can send or update its own; only the person and organizers can read it.
    function validRequest(d) {
      return d.keys().hasOnly(['email', 'name', 'program', 'phone', 'interests', 'level', 'heard', 'consent', 'lang', 'at', 'status', 'note'])
        && d.email == email()
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.program is string && d.program.size() <= 60
        && d.phone is string && d.phone.matches('^[+]?[0-9 ().-]{6,20}$')
        && d.interests is list && d.interests.size() <= 8
        && d.level in ['new', 'some', 'solid']
        && d.heard is string && d.heard.size() <= 200
        && d.consent == true
        && d.lang in ['en', 'fr']
        && d.at == request.time;
    }
    match /requests/{uid} {
      allow create: if school() && request.auth.uid == uid && validRequest(request.resource.data)
        && !('status' in request.resource.data) && !('note' in request.resource.data);
      // The person can edit their answers; only organizers set status ('invited', 'added') and notes.
      allow update: if school() && request.auth.uid == uid && validRequest(request.resource.data)
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('note', null) == resource.data.get('note', null);
      allow update: if isOrganizer();
      allow get: if signedIn() && request.auth.uid == uid;
      allow get, list, delete: if isOrganizer();
    }

    // The WhatsApp invite link (invites/whatsapp { link }) is kept here, never in the public repository.
    // Only people who sent the form (or are on the roster) can read it. Organizers set it in the console.
    match /invites/{id} {
      allow get: if school() && (exists(/databases/$(db)/documents/requests/$(request.auth.uid)) || onRoster());
      allow list, write: if isOrganizer();
    }

    // Feedback (the /feedback form). Anyone can send it, signed in or not; only organizers can read it.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['topic', 'rating', 'message', 'contact', 'lang', 'createdAt'])
        && request.resource.data.topic in ['sessions', 'platform', 'club', 'idea', 'problem', 'other']
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000
        && (!('rating' in request.resource.data) || (request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5))
        && (!('contact' in request.resource.data) || (request.resource.data.contact is string && request.resource.data.contact.size() <= 120))
        && request.resource.data.lang in ['en', 'fr']
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isOrganizer();
      allow update: if false;
    }

    // Email addresses: only the person and organizers can read them.
    match /private/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isOrganizer();
      allow write: if onRoster() && request.auth.uid == uid;
    }

    // One document per session code: { date: "YYYY-MM-DD", validFrom: timestamp, validUntil: timestamp, double: bool }.
    // Members can't read or list codes; the rules below only check that a typed code exists.
    match /checkinCodes/{c} {
      allow read, write: if isOrganizer();
    }

    match /facts/{id} {
      allow read: if isMember();

      // 1) Check-in: the code must exist, be for today's session and be used inside its time window.
      allow create: if isMember()
        && request.resource.data.type == 'attend'
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'approved'
        && id == request.auth.uid + '_' + request.resource.data.date
        && exists(/databases/$(db)/documents/checkinCodes/$(request.resource.data.code))
        && code(request.resource.data.code).date == request.resource.data.date
        && request.time >= code(request.resource.data.code).validFrom
        && request.time <= code(request.resource.data.code).validUntil;

      // 2) Proof submissions start as pending and earn nothing until an organizer verifies them.
      allow create: if isMember()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['ship_project', 'open_source', 'skill_badge', 'certification', 'mentoring']
        && request.resource.data.status == 'pending'
        && request.resource.data.proof is string && request.resource.data.proof.size() < 500;

      // 3) Organizers record results for other members (never for themselves).
      allow create: if isOrganizer()
        && request.resource.data.uid != request.auth.uid
        && request.resource.data.recordedBy == request.auth.uid;

      // 4) Organizers verify submissions from other members. Only the decision fields can change.
      allow update: if isOrganizer()
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reason', 'verifiedBy', 'verifiedAt'])
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.status in ['approved', 'rejected'];

      // Facts are never deleted. Corrections are new facts, so the log stays complete.
      allow delete: if false;
    }
  }
}
